# ManyHats Pro — Environment Variable Reference
# Copy this file to .env and fill in the values for your environment.
# Never commit real secrets to source control.

# ─── Supabase (required for all environments) ────────────────────────────────
# These are safe to expose in the browser. Set in frontend deployment config (e.g. Cloudflare Pages).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# ─── Supabase (server-side only — DO NOT expose to browser) ──────────────────
# Set in the server environment (Cloudflare Workers secrets or Supabase Edge Function secrets).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── Stripe (server-side only — DO NOT expose to browser) ────────────────────
# Used by Cloudflare Worker server functions (stripe.server.ts, stripe.functions.ts).
# Set in Cloudflare Workers secrets (wrangler secret put STRIPE_SECRET_KEY).
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

# ─── Stripe (browser — safe to expose) ───────────────────────────────────────
# Used by @stripe/stripe-js on the client to load Stripe Elements.
# Set in frontend deployment config (e.g. Cloudflare Pages environment variables).
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY

# ─── Resend email (server-side only — DO NOT expose to browser) ──────────────
# Used by email.server.ts for transactional email delivery.
# Set in Cloudflare Workers secrets (wrangler secret put RESEND_API_KEY).
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=ManyHats Pro <noreply@yourdomain.com>

# ─── App origin (server-side) ────────────────────────────────────────────────
# Used to build portal links in emails. Set in Cloudflare Workers config.
APP_ORIGIN=https://app.manyhats.pro

# ─── Firecrawl (server-side only) ────────────────────────────────────────────
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY

# ─── OpenAI / AI gateway (server-side only) ──────────────────────────────────
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ─── Variable configuration matrix ───────────────────────────────────────────
#
# Variable                     | Cloudflare Worker | CF Pages (VITE_*) | Supabase Edge Fn
# -----------------------------|-------------------|-------------------|------------------
# SUPABASE_URL                 |        ✓          |        ✓          |       built-in
# SUPABASE_PUBLISHABLE_KEY     |        ✓          |        ✓          |       built-in
# VITE_SUPABASE_URL            |        —          |        ✓          |       —
# VITE_SUPABASE_PUBLISHABLE_KEY|        —          |        ✓          |       —
# SUPABASE_SERVICE_ROLE_KEY    |        ✓ (secret) |        —          |       built-in
# STRIPE_SECRET_KEY            |        ✓ (secret) |        —          |       ✓ (secret)
# STRIPE_WEBHOOK_SECRET        |        ✓ (secret) |        —          |       ✓ (secret)
# VITE_STRIPE_PUBLISHABLE_KEY  |        —          |        ✓          |       —
# RESEND_API_KEY               |        ✓ (secret) |        —          |       ✓ (secret)
# RESEND_FROM_EMAIL            |        ✓          |        —          |       ✓
# APP_ORIGIN                   |        ✓          |        —          |       ✓
# FIRECRAWL_API_KEY            |        ✓ (secret) |        —          |       ✓ (secret)
# OPENAI_API_KEY               |        ✓ (secret) |        —          |       ✓ (secret)
#
# Note: "Cloudflare Worker" = the TanStack Start SSR / API layer.
#       "CF Pages (VITE_*)" = browser bundle — only VITE_* vars are inlined at build time.
#       "Supabase Edge Fn" = supabase/functions/* if you add Edge Functions later.
